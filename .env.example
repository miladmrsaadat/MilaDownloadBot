# ===================================================================
# Telegram Bot Configuration — نسخه ۲ (دانلودر + ابزار صوتی)
# ===================================================================

# توکن ربات دریافتی از @BotFather (اجباری)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# شناسه‌های عددی تلگرام کاربرانی که حق استفاده دارند (اختیاری)
# با کاما جدا کنید. خالی = عمومی. شناسه خود را با دستور /myid بگیرید.
ALLOWED_USERS=

# مسیر کش موقت و مدت نگهداری برای فعال ماندن دکمه‌ها (ساعت)
CACHE_DIR=/tmp/insta_bot_cache
CACHE_TTL_HOURS=2

# حداکثر حجم فایل دانلود به مگابایت (سقف تلگرام ۵۰ مگابایت)
MAX_FILE_SIZE_MB=50

# مسیر فایل کوکی اینستاگرام (خیلی مهم! برای دور زدن قفل لاگین اینستاگرام)
# COOKIES_FILE=./cookies.txt

# پروکسی تلگرام (در صورت اجرا روی سیستم ویندوزی در ایران بدون VPN)
# TELEGRAM_PROXY=socks5://127.0.0.1:10808
# TELEGRAM_PROXY=http://127.0.0.1:10809

# پروکسی اینستاگرام (اختیاری)
# INSTAGRAM_PROXY=http://user:pass@proxy-server:port

# مدل متن‌نویسی محلی: tiny (سبک‌ترین) / base / small / medium
WHISPER_MODEL=tiny

# کلید Groq رایگان برای متن‌نویسی فوق‌سریع در کلود (اختیاری): groq.com
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# کلید OpenAI برای Whisper رسمی (اختیاری)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# سطح لاگ: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
